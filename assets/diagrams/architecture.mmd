%% Source for architecture.svg. Render from assets/diagrams/:
%% npx @mermaid-js/mermaid-cli@11.4.0 -i architecture.mmd -o architecture.svg -c mermaid.config.json -b white
flowchart TB
    user([You])
    ext["Your extensions<br/>exercises/, examples/ (-e)"]
    subgraph pi2["pi2/"]
        direction TB
        cli["cli.py<br/>options, wires everything"]
        tui["tui.py · step 1<br/>InteractiveMode"]
        api["extensions.py<br/>ExtensionAPI: tools, handlers"]
        session["session.py · steps 2, 8<br/>AgentSession"]
        loop["agent_loop.py · steps 3, 6, 7<br/>run, execute_tool_call"]
        schema["schema.py · step 6<br/>validate_tool_arguments"]
        runtime["model_runtime.py · step 4<br/>ModelRuntime.stream_fn"]
        ai["ai.py · step 5<br/>OpenAI-compatible streaming"]
    end
    files[("~/.pi/agent<br/>models.json, python-sessions/")]
    llm[("LLM server<br/>e.g. Ollama /v1")]

    user <-->|"type / see"| tui
    cli -->|"pi.load(path)"| api
    ext -->|"extension(pi):<br/>register_tool, on"| api
    tui <-->|"prompt() / events"| session
    api -->|"tools, handlers"| session
    session <-->|"run(context, config) / events"| loop
    session -->|"save() .jsonl"| files
    loop -->|"arguments"| schema
    loop <-->|"execute(params, ctx) / result"| ext
    loop -->|"stream_fn"| runtime
    runtime -->|"reads"| files
    runtime --> ai
    ai <-->|"HTTP, streamed answer"| llm

    classDef yours fill:#fdecea,stroke:#c0504d,color:#4a1a18
    classDef pkg fill:#e8f0fe,stroke:#4a6fa5,color:#1a2b45
    classDef outside fill:#f3f4f6,stroke:#9aa7b8,color:#374151
    class ext yours
    class cli,tui,api,session,loop,schema,runtime,ai pkg
    class user,files,llm outside
    style pi2 fill:#f7f9fc,stroke:#9aa7b8
