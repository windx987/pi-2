flowchart LR
    pkg["packages/coding-agent<br/>the pi application"]
    subgraph ext["Extensions and tools"]
        direction TB
        fLoader["core/extensions/loader.ts"]
        fSchemas["tool parameters, settings schemas"]
        fDiff["core/tools/edit-diff.ts"]
        fSpawn["utils/child-process.ts"]
    end
    subgraph net["Network and storage"]
        direction TB
        fHttp["core/http-dispatcher.ts"]
        fLock["core/settings-manager.ts<br/>core/auth-storage.ts"]
    end
    subgraph res["Skills, packages, models"]
        direction TB
        fFront["utils/frontmatter.ts"]
        fPkg["core/package-manager.ts<br/>core/skills.ts"]
        fModel["core/model-resolver.ts"]
        fGit["utils/git.ts"]
    end
    subgraph ui["Terminal output"]
        direction TB
        fHl["utils/syntax-highlight.ts"]
        fMer["components/mermaid.ts"]
        fImg["utils/photon.ts"]
        fCli["main.ts, CLI commands"]
    end
    pkg --> ext
    pkg --> net
    pkg --> res
    pkg --> ui
    fLoader -.-> lJiti["jiti<br/>runs -e starter.ts without a build"]
    fSchemas -.-> lTb["typebox<br/>Type.Object, Static"]
    fDiff -.-> lDiff["diff"]
    fSpawn -.-> lSpawn["cross-spawn"]
    fHttp -.-> lUndici["undici<br/>proxies, timeouts"]
    fLock -.-> lLock["proper-lockfile"]
    fFront -.-> lYaml["yaml"]
    fPkg -.-> lPkg["ignore, semver"]
    fModel -.-> lGlob["minimatch, brace-expansion"]
    fGit -.-> lGit["hosted-git-info"]
    fHl -.-> lHl["highlight.js"]
    fMer -.-> lMer["lovely-mermaid"]
    fImg -.-> lImg["@silvia-odwyer/photon-node"]
    fCli -.-> lChalk["chalk"]

    classDef pkg fill:#e8f0fe,stroke:#4a6fa5,color:#1a2b45
    classDef file fill:#ffffff,stroke:#4a6fa5,color:#1a2b45
    classDef lib fill:#f3f4f6,stroke:#9aa7b8,color:#4b5563
    classDef key fill:#fdecea,stroke:#c0504d,color:#4a1a18
    class pkg pkg
    class fLoader,fSchemas,fDiff,fSpawn,fHttp,fLock,fFront,fPkg,fModel,fGit,fHl,fMer,fImg,fCli file
    class lSpawn,lUndici,lLock,lYaml,lPkg,lGlob,lGit,lHl,lMer,lImg,lChalk lib
    class lJiti,lTb,lDiff key
    style ext fill:#f7f9fc,stroke:#9aa7b8
    style net fill:#f7f9fc,stroke:#9aa7b8
    style res fill:#f7f9fc,stroke:#9aa7b8
    style ui fill:#f7f9fc,stroke:#9aa7b8
