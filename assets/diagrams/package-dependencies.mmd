flowchart LR
    ca["coding-agent<br/>the pi application"]
    agent["agent<br/>pi-agent-core"]
    ai["ai<br/>pi-ai"]
    tui["tui<br/>pi-tui"]
    mcp["mcp"]
    codemode["codemode"]
    schema["schema<br/>pi-schema"]
    telemetry["telemetry<br/>pi-telemetry"]
    caLibs["typebox, jiti, undici, diff,<br/>highlight.js, yaml, ..."]
    aiLibs["openai, @anthropic-ai/sdk,<br/>@google/genai,<br/>AWS Bedrock SDK,<br/>proxy agents, partial-json"]
    tuiLibs["marked, marked-cjk-friendly,<br/>get-east-asian-width"]
    mcpLibs["cross-spawn"]
    cmLibs["quickjs-wasi"]

    ca --> agent
    ca --> ai
    ca --> tui
    ca --> mcp
    ca --> codemode
    agent --> ai
    agent --> schema
    ai --> schema
    ai --> telemetry

    ca -.-> caLibs
    ai -.-> aiLibs
    tui -.-> tuiLibs
    mcp -.-> mcpLibs
    codemode -.-> cmLibs

    classDef pkg fill:#e8f0fe,stroke:#4a6fa5,color:#1a2b45
    classDef none fill:#e6f4ea,stroke:#3c8d5a,color:#16351f
    classDef lib fill:#f3f4f6,stroke:#9aa7b8,color:#4b5563
    class ca,ai,tui,mcp,codemode pkg
    class agent,schema,telemetry none
    class caLibs,aiLibs,tuiLibs,mcpLibs,cmLibs lib
